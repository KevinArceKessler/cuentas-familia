# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). La anon key es pública: está pensada para el navegador.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Usuario del bot de Telegram, sin @ (por ejemplo cuentas_arce_bot)
VITE_TELEGRAM_BOT=
